<?xml version="1.0" encoding="utf-8"?>
<BadBlobs>
    <!-- Windows NT Kernel: In-place SSE4.2 requirement patch -->
    <Blob id="ntoskrnl" action="patch" patcher="kernel_sse42" enabled="true">
        <Target>Windows/System32/ntoskrnl.exe</Target>
        <Description>Windows 11's NT Kernel (Bypasses SSE4.2 CPUID requirement table check)</Description>
        <Options>
            <!-- You probably don't need to change any of these, but they can be useful for debugging-->
            <Option name="patch_cpuid" value="true" />
            <Option name="patch_kiset" value="false" />
            <!-- This indirectly disables bugchecks/BSODs. Do not enable unless you are debugging-->
            <Option name="debug_loop" value="false" />
        </Options>
    </Blob>

    <!-- Windows Codecs 64-bit library: Replaces SSE4.1 PMOVSXBW build with 23H2 binary -->
    <Blob id="wincodecs" action="replace" file="WindowsCodecs.dll" enabled="true">
        <Target>Windows/System32/WindowsCodecs.dll</Target>
        <Description>Windows Codecs 64-bit library (Replaces SSE4.1 instructions with 23H2 build)</Description>
    </Blob>

    <!-- Windows Boot Loader: In-place Code Integrity and testsigning bypass (Disabled by default) -->
    <!-- This is experimental and can lead to unbootable ISOs. Only flip to true if you know this'll work for you-->
    <Blob id="winload_boot_efi" action="patch" patcher="winload" enabled="false">
        <Target>Windows/System32/boot/winload.efi</Target>
        <Description>Windows Boot Loader UEFI (Bypasses CI check and preserves testsigning without F8)</Description>
        <Options>
            <Option name="patch_ci_filter" value="true" />
            <Option name="patch_boot_options" value="true" />
        </Options>
    </Blob>

    <Blob id="winload_sys32_efi" action="patch" patcher="winload" enabled="false">
        <Target>Windows/System32/winload.efi</Target>
        <Description>Windows Boot Loader UEFI System32 (Bypasses CI check and preserves testsigning without F8)</Description>
        <Options>
            <Option name="patch_ci_filter" value="true" />
            <Option name="patch_boot_options" value="true" />
        </Options>
    </Blob>

    <Blob id="winload_exe" action="patch" patcher="winload" enabled="false">
        <Target>Windows/System32/winload.exe</Target>
        <Description>Windows Boot Loader Legacy BIOS (Bypasses CI check and preserves testsigning without F8)</Description>
        <Options>
            <Option name="patch_ci_filter" value="true" />
            <Option name="patch_boot_options" value="true" />
        </Options>
    </Blob>
</BadBlobs>
